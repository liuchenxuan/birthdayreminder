<ci:ComponentBase x:Class="BirthdayReminder.Controls.BirthdayComponentSettingsControl"
                  x:TypeArguments="models:BirthdayComponentSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:local="clr-namespace:BirthdayReminder.Controls"
                  xmlns:models="clr-namespace:BirthdayReminder.Models"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  mc:Ignorable="d"
                  d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro" Margin="0"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:BirthdayComponentSettingsControl}}">

            <fa:SettingsExpander Header="今日寿星" Description="在组件中显示今天过生日的人。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowToday}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="下一个生日" Description="显示距离现在最近的下一个生日是谁。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowNext}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="显示倒计时" Description="下一个生日后面显示“还有 N 天”，关闭则显示“明天/3天后”。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowCountdown}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="本月生日列表" Description="显示本月剩余的生日（已过去的不计入）。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowMonthList}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="显示年龄" Description="在姓名后面显示将满的年龄（需名单里有出生年份）。">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowAge}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="显示方式" Description="主界面组件高度有限，内容较多时建议使用轮播。">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Mode}" MinWidth="160">
                        <ComboBoxItem Content="合并显示在一行"/>
                        <ComboBoxItem Content="依次轮播"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="轮播间隔（秒）" Description="轮播模式下每一段内容停留的时间。">
                <fa:SettingsExpander.Footer>
                    <Slider Width="200" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.RotateSeconds}" Classes="auto-tooltip"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="没有内容时显示的文字">
                <fa:SettingsExpander.Footer>
                    <TextBox MinWidth="200" Text="{Binding Settings.EmptyText, UpdateSourceTrigger=PropertyChanged}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>

            <fa:SettingsExpander Header="没有内容时隐藏组件">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.HideWhenEmpty}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
